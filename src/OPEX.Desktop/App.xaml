<Application x:Class="OPEX.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="AppBackground" Color="#0B1220"/>
  <SolidColorBrush x:Key="PanelBackground" Color="#111C2D"/>
  <SolidColorBrush x:Key="Accent" Color="#438BE8"/>
  <SolidColorBrush x:Key="Muted" Color="#91A4BB"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="Background" Value="#244B78"/>
   <Setter Property="BorderBrush" Value="#365D89"/>
   <Setter Property="Padding" Value="14,9"/>
   <Setter Property="Margin" Value="0,0,8,8"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
 </Application.Resources>
</Application>
