<Window x:Class="OPEX.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="OPEX Control" Height="760" Width="1240" MinHeight="650" MinWidth="1050"
 WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="{StaticResource PanelBackground}" CornerRadius="14" Padding="22" Margin="0,0,0,16">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="OPEX CONTROL" Foreground="#A9D0FF" FontSize="12" FontWeight="Bold" />
     <TextBlock Text="Operational Excellence Workspace" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0"/>
     <TextBlock Text="Local Windows application · Shared SMB storage · No cloud services" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
     <TextBlock x:Name="ConnectionLabel" Text="WORKSPACE NOT CONNECTED" Foreground="#F5C66B" FontWeight="Bold" HorizontalAlignment="Right"/>
     <Button x:Name="ConnectButton" Content="Select shared workspace" Click="ConnectButton_Click" Margin="0,10,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource PanelBackground}" CornerRadius="14" Padding="14" Margin="0,0,16,0">
    <StackPanel>
     <TextBlock Text="WORKSPACE" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" Margin="8,6,0,14"/>
     <Button Content="Overview" HorizontalContentAlignment="Left"/>
     <Button Content="Users &amp; Roles" HorizontalContentAlignment="Left" IsEnabled="False"/>
     <Button Content="Teams" HorizontalContentAlignment="Left" IsEnabled="False"/>
     <Button Content="Forms" HorizontalContentAlignment="Left" IsEnabled="False"/>
     <Button Content="Submissions" HorizontalContentAlignment="Left" IsEnabled="False"/>
     <Button Content="Supervisor Review" HorizontalContentAlignment="Left" IsEnabled="False"/>
     <Button Content="Dashboards" HorizontalContentAlignment="Left" IsEnabled="False"/>
     <Button Content="Audit &amp; Integrity" HorizontalContentAlignment="Left" IsEnabled="False"/>
     <Button Content="Reports &amp; Export" HorizontalContentAlignment="Left" IsEnabled="False"/>
     <Button Content="Backup &amp; Recovery" HorizontalContentAlignment="Left" IsEnabled="False"/>
    </StackPanel>
   </Border>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <TextBlock Text="System readiness" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,14"/>
     <UniformGrid Columns="3" Margin="0,0,0,16">
      <Border Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="16" Margin="0,0,10,0">
       <StackPanel><TextBlock Text="Storage" Foreground="{StaticResource Muted}"/><TextBlock x:Name="StorageStatus" Text="Not connected" Foreground="White" FontSize="19" Margin="0,8,0,0"/></StackPanel>
      </Border>
      <Border Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="16" Margin="0,0,10,0">
       <StackPanel><TextBlock Text="Shared write test" Foreground="{StaticResource Muted}"/><TextBlock x:Name="WriteStatus" Text="Not tested" Foreground="White" FontSize="19" Margin="0,8,0,0"/></StackPanel>
      </Border>
      <Border Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="16">
       <StackPanel><TextBlock Text="Application mode" Foreground="{StaticResource Muted}"/><TextBlock Text="100% local" Foreground="#6ED6B0" FontSize="19" Margin="0,8,0,0"/></StackPanel>
      </Border>
     </UniformGrid>
     <Border Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="20">
      <StackPanel>
       <TextBlock Text="Getting started" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
       <TextBlock x:Name="WorkspacePath" Text="Select the network folder used by all OPEX workstations." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,12"/>
       <TextBlock x:Name="ActivityText" Text="No workspace has been initialized." Foreground="#C8D6E6" TextWrapping="Wrap"/>
       <Button x:Name="TestButton" Content="Run shared-folder write test" HorizontalAlignment="Left" Click="TestButton_Click" IsEnabled="False" Margin="0,18,0,0"/>
      </StackPanel>
     </Border>
     <TextBlock Text="Build status: foundation and shared-folder bootstrap. Workflow modules will be enabled only after their validation tests pass." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,16,4,0"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Grid>
</Window>
